{
  "name": "fasttrack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=11.20.0 <12"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace @fasttrack/server\" \"npm run dev --workspace @fasttrack/client\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run start --workspace @fasttrack/server",
    "test:g1": "vitest run --config vitest.g1.config.ts",
    "test:g1:isolated": "node scripts/run-g1.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "vite": "8.3.6"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}

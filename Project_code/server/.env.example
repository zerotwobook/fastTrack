# Copy to server/.env. Local development placeholders only; never commit real credentials.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://fasttrack_dev:replace_me@127.0.0.1:5432/fasttrack_dev
# Provision a separate database/user before database tests. A00 does not create or reset it.
TEST_DATABASE_URL=postgresql://fasttrack_test:replace_me@127.0.0.1:5432/fasttrack_test
SESSION_TTL_HOURS=8
RELEASE_SHA=development
# B's seed task will require an explicitly supplied demo password. No default password is used.
DEMO_SEED_PASSWORD=

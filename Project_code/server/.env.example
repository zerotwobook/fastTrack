# Copy to server/.env. Local development placeholders only; never commit real credentials.
# IMPORTANT: PostgreSQL port on this machine is 5433 (not the default 5432).
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://fasttrack_dev:replace_me@127.0.0.1:5433/fasttrack_dev
# Provision a separate database/user before database tests. A00 does not create or reset it.
TEST_DATABASE_URL=postgresql://fasttrack_test:replace_me@127.0.0.1:5433/fasttrack_test
SESSION_TTL_HOURS=8
RELEASE_SHA=development
# B's seed task will require an explicitly supplied demo password. No default password is used.
DEMO_SEED_PASSWORD=
# Bounded runtime DB operations and readiness; no secret values in these settings.
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=1000
DB_QUERY_TIMEOUT_MS=1500
READINESS_TIMEOUT_MS=3000
# Keep 0 locally. Use 1 on cloud only after verifying the actual proxy/header path.
TRUST_PROXY_HOPS=0
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCK_SECONDS=900
LOGIN_RATE_LIMIT_RETENTION_SECONDS=3600
# Explicit maintenance only; leave blank for ordinary application use.
CONFIRM_RATE_LIMIT_CLEANUP=

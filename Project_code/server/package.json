{
  "name": "@fasttrack/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "npm run db:generate && tsc -p tsconfig.build.json && node ../scripts/copy-prisma-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:migrate": "prisma migrate deploy --config ../prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config ../prisma.config.ts",
    "db:generate": "prisma generate --config ../prisma.config.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
